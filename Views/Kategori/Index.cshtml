@model IEnumerable<EnvanterTakip.Models.Kategori>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="row mb-3">
    <div class="col-md-6">
        <h2>Kategoriler</h2>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">Yeni Kategori Ekle</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Açıklama</th>
                <th>İkon</th>
                <th>Renk</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Ad</td>
                    <td>@item.Aciklama</td>
                    <td>@item.Ikon</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.Renk))
                        {
                            <span class="badge" style="background-color: @item.Renk">@item.Renk</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
