@{
    ViewData["Title"] = "Sakarya Kent Rehberi";
}

<div class="jumbotron text-center bg-light p-5 rounded">
    <h1 class="display-4">Sakarya Kent Rehberi'ne Hoş Geldiniz</h1>
    <p class="lead">Şehrimizdeki tüm önemli konumları keşfedin ve harita üzerinde görüntüleyin.</p>
    <hr class="my-4">
    <p>Hastaneler, bankalar, resmi kurumlar, parklar ve daha fazlası...</p>
    <a class="btn btn-primary btn-lg" asp-controller="Harita" asp-action="Index" role="button">Haritayı Görüntüle</a>
    @if (User.Identity.IsAuthenticated)
    {
        <a class="btn btn-secondary btn-lg" asp-controller="Konum" asp-action="Create" role="button">Yeni Konum Ekle</a>
    }
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-map" style="font-size: 3rem; color: #0d6efd;"></i>
                <h5 class="card-title mt-3">İnteraktif Harita</h5>
                <p class="card-text">Şehirdeki tüm konumları interaktif harita üzerinde görüntüleyin.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-search" style="font-size: 3rem; color: #0d6efd;"></i>
                <h5 class="card-title mt-3">Gelişmiş Arama</h5>
                <p class="card-text">İstediğiniz konumu kolayca bulun ve detaylarına ulaşın.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-info-circle" style="font-size: 3rem; color: #0d6efd;"></i>
                <h5 class="card-title mt-3">Detaylı Bilgiler</h5>
                <p class="card-text">Her konum için adres, telefon ve çalışma saatleri bilgileri.</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}
