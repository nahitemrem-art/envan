@model EnvanterTakip.Models.Konum

@{
    ViewData["Title"] = Model.Ad + " - Turizm Rehberi";
}

<div class="row mb-3">
    <div class="col-md-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a asp-controller="Turizm" asp-action="Index">Turizm Rehberi</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Ad</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            @if (!string.IsNullOrEmpty(Model.ResimUrl))
            {
                <img src="@Model.ResimUrl" class="card-img-top" alt="@Model.Ad" style="max-height: 400px; object-fit: cover;">
            }
            <div class="card-body">
                <h2 class="card-title">@Model.Ad</h2>
                <span class="badge mb-3" style="background-color: @(Model.Kategori?.Renk ?? "#6c757d"); font-size: 1rem;">
                    @Model.Kategori?.Ad
                </span>
                
                @if (!string.IsNullOrEmpty(Model.Aciklama))
                {
                    <p class="card-text">@Model.Aciklama</p>
                }

                <hr>

                <div class="row">
                    @if (!string.IsNullOrEmpty(Model.Adres))
                    {
                        <div class="col-md-12 mb-3">
                            <h6><i class="bi bi-geo-alt"></i> Adres</h6>
                            <p>@Model.Adres</p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Telefon))
                    {
                        <div class="col-md-6 mb-3">
                            <h6><i class="bi bi-telephone"></i> Telefon</h6>
                            <p><a href="tel:@Model.Telefon">@Model.Telefon</a></p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div class="col-md-6 mb-3">
                            <h6><i class="bi bi-envelope"></i> E-posta</h6>
                            <p><a href="mailto:@Model.Email">@Model.Email</a></p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <div class="col-md-12 mb-3">
                            <h6><i class="bi bi-globe"></i> Website</h6>
                            <p><a href="@Model.Website" target="_blank">@Model.Website</a></p>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.CalismaSaatleri))
                    {
                        <div class="col-md-12 mb-3">
                            <h6><i class="bi bi-clock"></i> Çalışma Saatleri</h6>
                            <p>@Model.CalismaSaatleri</p>
                        </div>
                    }
                </div>

                <div class="mt-3">
                    <a asp-controller="Turizm" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Listeye Dön
                    </a>
                    <a href="https://www.google.com/maps/dir/?api=1&destination=@Model.Enlem.ToString(System.Globalization.CultureInfo.InvariantCulture),@Model.Boylam.ToString(System.Globalization.CultureInfo.InvariantCulture)" 
                       target="_blank" 
                       class="btn btn-primary">
                        <i class="bi bi-map"></i> Yol Tarifi Al
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                <h5>📍 Harita</h5>
            </div>
            <div class="card-body p-0">
                <div id="map" style="height: 300px; width: 100%;"></div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5>📊 Bilgiler</h5>
            </div>
            <div class="card-body">
                <p><strong>Kategori:</strong> @Model.Kategori?.Ad</p>
                <p><strong>Koordinatlar:</strong><br>
                   Enlem: @Model.Enlem<br>
                   Boylam: @Model.Boylam
                </p>
                <p><strong>Eklenme Tarihi:</strong><br>@Model.EklenmeTarihi.ToLocalTime().ToString("dd.MM.yyyy")</p>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var enlem = @Model.Enlem.ToString(System.Globalization.CultureInfo.InvariantCulture);
        var boylam = @Model.Boylam.ToString(System.Globalization.CultureInfo.InvariantCulture);
        
        var map = L.map('map').setView([enlem, boylam], 15);
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        L.marker([enlem, boylam])
            .addTo(map)
            .bindPopup('<b>@Model.Ad</b><br>@Model.Kategori?.Ad')
            .openPopup();
    </script>
}
