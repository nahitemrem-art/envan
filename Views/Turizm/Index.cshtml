@model IEnumerable<EnvanterTakip.Models.Konum>

@{
    ViewData["Title"] = "Sakarya Turizm Rehberi";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h2>🏖️ Sakarya Turizm Rehberi</h2>
        <p class="lead">Sakarya'nın tarihi ve turistik mekanlarını keşfedin</p>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-12">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-4">
                <label for="kategoriId" class="form-label">Kategori</label>
                <select name="kategoriId" id="kategoriId" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var kategori in ViewBag.Kategoriler as IEnumerable<EnvanterTakip.Models.Kategori>)
                    {
                        <option value="@kategori.Id">@kategori.Ad</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label for="arama" class="form-label">Arama</label>
                <input type="text" name="arama" id="arama" class="form-control" placeholder="Mekan adı, açıklama veya adres..." />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">🔍 Ara</button>
            </div>
        </form>
    </div>
</div>

<div id="map" style="height: 500px; width: 100%; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);"></div>

<div class="row mt-4">
    <div class="col-md-12">
        <h4>📍 Turistik Mekanlar (@Model.Count())</h4>
    </div>
</div>

<div class="row">
    @if (Model.Any())
    {
        foreach (var konum in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(konum.ResimUrl))
                    {
                        <img src="@konum.ResimUrl" class="card-img-top" alt="@konum.Ad" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="bi bi-image" style="font-size: 3rem; color: white;"></i>
                        </div>
                    }
                    <div class="card-body">
                        <h5 class="card-title">@konum.Ad</h5>
                        <span class="badge mb-2" style="background-color: @(konum.Kategori?.Renk ?? "#6c757d")">
                            @konum.Kategori?.Ad
                        </span>
                        @if (!string.IsNullOrEmpty(konum.Aciklama))
                        {
                            <p class="card-text">
                                @(konum.Aciklama.Length > 100 ? konum.Aciklama.Substring(0, 100) + "..." : konum.Aciklama)
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(konum.Adres))
                        {
                            <p class="card-text">
                                <small class="text-muted">
                                    <i class="bi bi-geo-alt"></i> @konum.Adres
                                </small>
                            </p>
                        }
                    </div>
                    <div class="card-footer bg-white">
                        <a asp-action="Detay" asp-route-id="@konum.Id" class="btn btn-sm btn-primary">
                            <i class="bi bi-info-circle"></i> Detaylar
                        </a>
                        <button class="btn btn-sm btn-outline-primary" onclick="goToLocation(@konum.Enlem.ToString(System.Globalization.CultureInfo.InvariantCulture), @konum.Boylam.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            <i class="bi bi-pin-map"></i> Haritada Göster
                        </button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-md-12">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> Henüz turistik mekan eklenmemiş.
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map').setView([40.7569, 30.3781], 12);
        
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var markers = [];

        @foreach (var konum in Model)
        {
            var enlem = konum.Enlem.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var boylam = konum.Boylam.ToString(System.Globalization.CultureInfo.InvariantCulture);
            <text>
            var marker = L.marker([@enlem, @boylam]).addTo(map);
            marker.bindPopup(`
                <div style="min-width: 200px;">
                    <h6>@konum.Ad</h6>
                    <span class="badge" style="background-color: @(konum.Kategori?.Renk ?? "#6c757d")">@konum.Kategori?.Ad</span>
                    @if (!string.IsNullOrEmpty(konum.Adres))
                    {
                        <p class="mb-1 mt-2"><small><i class="bi bi-geo-alt"></i> @konum.Adres</small></p>
                    }
                    <a href="@Url.Action("Detay", new { id = konum.Id })" class="btn btn-sm btn-primary mt-2">Detaylar</a>
                </div>
            `);
            markers.push({marker: marker, lat: @enlem, lng: @boylam});
            </text>
        }

        function goToLocation(lat, lng) {
            map.setView([lat, lng], 16);
            markers.forEach(m => {
                if (Math.abs(m.lat - lat) < 0.0001 && Math.abs(m.lng - lng) < 0.0001) {
                    m.marker.openPopup();
                }
            });
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
}
