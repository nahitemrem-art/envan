@model IEnumerable<EnvanterTakip.Models.Konum>
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "Konum Yönetimi";
    var currentUser = User.Identity?.Name;
    var isAdmin = User.IsInRole("Admin");
}

<div class="row mb-3">
    <div class="col-md-6">
        <h2>Konumlar</h2>
    </div>
    <div class="col-md-6 text-end">
        <a asp-action="Create" class="btn btn-primary">Yeni Konum Ekle</a>
        <a asp-controller="Kategori" asp-action="Index" class="btn btn-secondary">Kategoriler</a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-12">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="arama" class="form-control" placeholder="Konum ara..." value="@Context.Request.Query["arama"]">
            </div>
            <div class="col-md-4">
                <select name="kategoriId" class="form-select">
                    <option value="">Tüm Kategoriler</option>
                    @foreach (var kategori in ViewBag.Kategoriler as IEnumerable<EnvanterTakip.Models.Kategori>)
                    {
                        <option value="@kategori.Id" selected="@(Context.Request.Query["kategoriId"] == kategori.Id.ToString())">
                            @kategori.Ad
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Ara</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Temizle</a>
            </div>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Kategori</th>
                <th>Adres</th>
                <th>Telefon</th>
                <th>Aktif</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Ad</td>
                    <td>
                        <span class="badge" style="background-color: @item.Kategori?.Renk ?? "#6c757d">
                            @item.Kategori?.Ad
                        </span>
                    </td>
                    <td>@item.Adres</td>
                    <td>@item.Telefon</td>
                    <td>
                        @if (item.Aktif)
                        {
                            <span class="badge bg-success">Evet</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Hayır</span>
                        }
                    </td>
                    <td>
                        @if (isAdmin || item.EkleyenKullanici == currentUser)
                        {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                        }
                        else
                        {
                            <span class="text-muted small">Yetkiniz yok</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
