@model EnvanterTakip.Models.Konum

@{
    ViewData["Title"] = "Konum Düzenle";
}

<h2>Konum Düzenle</h2>

<hr>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="EklenmeTarihi" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Ad" class="form-label"></label>
                        <input asp-for="Ad" class="form-control" />
                        <span asp-validation-for="Ad" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="KategoriId" class="form-label">Kategori</label>
                        <select asp-for="KategoriId" class="form-select">
                            <option value="">Kategori Seçin</option>
                            @foreach (var kategori in ViewBag.Kategoriler as IEnumerable<EnvanterTakip.Models.Kategori>)
                            {
                                <option value="@kategori.Id">@kategori.Ad</option>
                            }
                        </select>
                        <span asp-validation-for="KategoriId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label"></label>
                <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Aciklama" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Adres" class="form-label"></label>
                <textarea asp-for="Adres" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Adres" class="text-danger"></span>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Telefon" class="form-label"></label>
                        <input asp-for="Telefon" class="form-control" />
                        <span asp-validation-for="Telefon" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Website" class="form-label"></label>
                <input asp-for="Website" type="url" class="form-control" />
                <span asp-validation-for="Website" class="text-danger"></span>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Enlem" class="form-label">Enlem (Latitude)</label>
                        <input asp-for="Enlem" type="number" step="0.0000001" class="form-control" />
                        <span asp-validation-for="Enlem" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Boylam" class="form-label">Boylam (Longitude)</label>
                        <input asp-for="Boylam" type="number" step="0.0000001" class="form-control" />
                        <span asp-validation-for="Boylam" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="ResimUrl" class="form-label"></label>
                <input asp-for="ResimUrl" type="url" class="form-control" />
                <span asp-validation-for="ResimUrl" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="CalismaSaatleri" class="form-label"></label>
                <input asp-for="CalismaSaatleri" class="form-control" />
                <span asp-validation-for="CalismaSaatleri" class="text-danger"></span>
            </div>
            
            <div class="mb-3 form-check">
                <input asp-for="Aktif" class="form-check-input" type="checkbox" />
                <label asp-for="Aktif" class="form-check-label"></label>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
