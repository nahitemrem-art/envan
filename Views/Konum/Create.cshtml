@model EnvanterTakip.Models.Konum

@{
    ViewData["Title"] = "Yeni Konum";
}

<h2>Yeni Konum Ekle</h2>

<hr>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Ad" class="form-label"></label>
                        <input asp-for="Ad" class="form-control" />
                        <span asp-validation-for="Ad" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="KategoriId" class="form-label">Kategori</label>
                        <select asp-for="KategoriId" class="form-select">
                            <option value="">Kategori Seçin</option>
                            @foreach (var kategori in ViewBag.Kategoriler as IEnumerable<EnvanterTakip.Models.Kategori>)
                            {
                                <option value="@kategori.Id">@kategori.Ad</option>
                            }
                        </select>
                        <span asp-validation-for="KategoriId" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Aciklama" class="form-label"></label>
                <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Aciklama" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="Adres" class="form-label"></label>
                <textarea asp-for="Adres" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Adres" class="text-danger"></span>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Telefon" class="form-label"></label>
                        <input asp-for="Telefon" class="form-control" />
                        <span asp-validation-for="Telefon" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="Website" class="form-label"></label>
                <input asp-for="Website" type="url" class="form-control" />
                <span asp-validation-for="Website" class="text-danger"></span>
            </div>
            
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Enlem" class="form-label">Enlem (Latitude)</label>
                        <input asp-for="Enlem" type="number" step="0.0000001" class="form-control" />
                        <span asp-validation-for="Enlem" class="text-danger"></span>
                        <small class="form-text text-muted">Örn: 40.7569</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Boylam" class="form-label">Boylam (Longitude)</label>
                        <input asp-for="Boylam" type="number" step="0.0000001" class="form-control" />
                        <span asp-validation-for="Boylam" class="text-danger"></span>
                        <small class="form-text text-muted">Örn: 30.3781</small>
                    </div>
                </div>
            </div>
            
            <div class="mb-3">
                <label asp-for="ResimUrl" class="form-label"></label>
                <input asp-for="ResimUrl" type="url" class="form-control" />
                <span asp-validation-for="ResimUrl" class="text-danger"></span>
            </div>
            
            <div class="mb-3">
                <label asp-for="CalismaSaatleri" class="form-label"></label>
                <input asp-for="CalismaSaatleri" class="form-control" placeholder="Örn: Pazartesi-Cuma 09:00-18:00" />
                <span asp-validation-for="CalismaSaatleri" class="text-danger"></span>
            </div>
            
            <div class="mb-3 form-check">
                <input asp-for="Aktif" class="form-check-input" type="checkbox" checked />
                <label asp-for="Aktif" class="form-check-label"></label>
            </div>
            
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Yardım</h5>
            </div>
            <div class="card-body">
                <p><strong>Koordinat Bulmak İçin:</strong></p>
                <ol>
                    <li>Google Maps'i açın</li>
                    <li>Konuma sağ tıklayın</li>
                    <li>"Burası ne?" seçeneğine tıklayın</li>
                    <li>Alt kısımda koordinatlar görünecek</li>
                </ol>
                <p class="mb-0"><small>İlk değer Enlem, ikinci değer Boylam'dır.</small></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
