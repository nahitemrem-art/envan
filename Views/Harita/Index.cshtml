@model IEnumerable<EnvanterTakip.Models.Konum>

@{
    ViewData["Title"] = "Sakarya Kent Rehberi - Harita";
}

<div class="row mb-3">
    <div class="col-md-12">
        <h2>Sakarya Kent Rehberi</h2>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-12">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="arama" class="form-control" placeholder="Konum ara..." value="@Context.Request.Query["arama"]">
            </div>
            <div class="col-md-4">
                <select name="kategoriId" class="form-select" id="kategoriSelect">
                    <option value="">Tüm Kategoriler</option>
                    @foreach (var kategori in ViewBag.Kategoriler as IEnumerable<EnvanterTakip.Models.Kategori>)
                    {
                        <option value="@kategori.Id" selected="@(Context.Request.Query["kategoriId"] == kategori.Id.ToString())">
                            @kategori.Ad
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary">Ara</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Temizle</a>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-md-4" style="max-height: 600px; overflow-y: auto;">
        <div class="list-group">
            @foreach (var konum in Model)
            {
                <a href="#" class="list-group-item list-group-item-action konum-item" 
                   data-id="@konum.Id"
                   data-enlem="@konum.Enlem.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                   data-boylam="@konum.Boylam.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1">@konum.Ad</h6>
                        <small>
                            <span class="badge" style="background-color: @konum.Kategori?.Renk ?? "#6c757d">
                                @konum.Kategori?.Ad
                            </span>
                        </small>
                    </div>
                    @if (!string.IsNullOrEmpty(konum.Adres))
                    {
                        <p class="mb-1"><small>@konum.Adres</small></p>
                    }
                    @if (!string.IsNullOrEmpty(konum.Telefon))
                    {
                        <p class="mb-1"><small><i class="bi bi-telephone"></i> @konum.Telefon</small></p>
                    }
                </a>
            }
        </div>
    </div>
    <div class="col-md-8">
        <div id="map" style="height: 600px; width: 100%;"></div>
    </div>
</div>

<div class="modal fade" id="konumModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="konumModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="konumModalBody">
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
}

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        var map = L.map('map').setView([40.7569, 30.3781], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);

        var markers = [];

        @foreach (var konum in Model)
        {
            <text>
            var marker = L.marker([@konum.Enlem.ToString(System.Globalization.CultureInfo.InvariantCulture), @konum.Boylam.ToString(System.Globalization.CultureInfo.InvariantCulture)])
                .addTo(map)
                .bindPopup(`
                    <div class="p-2">
                        <h6>@Html.Raw(konum.Ad)</h6>
                        @if (!string.IsNullOrEmpty(konum.Adres))
                        {
                            <p class="mb-1"><small>@Html.Raw(konum.Adres)</small></p>
                        }
                        @if (!string.IsNullOrEmpty(konum.Telefon))
                        {
                            <p class="mb-1"><small><i class="bi bi-telephone"></i> @Html.Raw(konum.Telefon)</small></p>
                        }
                        <a href="@Url.Action("Detay", "Harita", new { id = konum.Id })" class="btn btn-sm btn-primary mt-2">Detaylar</a>
                    </div>
                `);
            markers.push({ id: @konum.Id, marker: marker });
            </text>
        }

        document.querySelectorAll('.konum-item').forEach(function(item) {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                var enlem = parseFloat(this.dataset.enlem);
                var boylam = parseFloat(this.dataset.boylam);
                var id = parseInt(this.dataset.id);
                
                map.setView([enlem, boylam], 16);
                
                var markerObj = markers.find(m => m.id === id);
                if (markerObj) {
                    markerObj.marker.openPopup();
                }
            });
        });

        document.getElementById('kategoriSelect').addEventListener('change', function() {
            this.form.submit();
        });
    </script>
}
